APP_NAME=Omniflow
APP_ENV=development

DATABASE_URL=postgresql+psycopg://omniflow:CHANGE_ME@127.0.0.1:5433/omniflow

REDIS_URL=redis://127.0.0.1:6379/0

FRONTEND_URL=http://localhost:3000
# Optional comma-separated browser origins for deployments with multiple
# frontends. When blank, FRONTEND_URL remains the single-origin fallback.
FRONTEND_ORIGINS=

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

INVITATION_EXPIRE_HOURS=72

# Comma-separated Fernet keys, newest first. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: prepend a new key and keep old keys until data is re-encrypted.
CHANNEL_CREDENTIAL_KEYS=

# Meta app (WhatsApp Cloud API). Required for connect and webhooks.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
# Random string; enter the same value in the Meta webhook settings.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Media storage ("local" for development; S3/R2/MinIO later).
MEDIA_STORAGE_BACKEND=local
# Empty = backend/var/media (git-ignored)
MEDIA_LOCAL_ROOT=
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30
MEDIA_MAX_DOWNLOAD_ATTEMPTS=3

# OpenAI (platform AI replies + knowledge-base embeddings).
# Empty disables AI replies (safe no-op) and falls back to mock embeddings.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Credits charged per 1,000 tokens (prompt + completion).
AI_CREDITS_PER_1K_TOKENS=1.0
AI_REPLY_MAX_TOKENS=500
AI_REPLY_TEMPERATURE=0.3

# Razorpay (AI-credit purchases). Empty disables the purchase flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required only for the legacy local Compose setup.
POSTGRES_PASSWORD=
